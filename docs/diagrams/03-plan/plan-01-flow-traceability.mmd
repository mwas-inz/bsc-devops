---
config:
  theme: neo
  themeVariables:
    fontSize: 22px
  flowchart:
    nodeSpacing: 30
    rankSpacing: 40
    padding: 4
    diagramPadding: 8
    wrappingWidth: 600
---
%% Proces identyfikowalności — od wymagania do działającej wersji
flowchart TB
    subgraph r1[" "]
        direction LR
        jira["Zadanie Jira<br/>INZ-XX"]
        br["Gałąź<br/>feature/INZ-XX-opis"]
        com["Commit<br/>Conventional Commits<br/>stopka: Resolves INZ-XX"]
        pr["Pull Request<br/>kontrole stanu per usługa"]
        jira --> br --> com --> pr
        br -.-> jira
        com -.->|"automatyczne<br/>powiązanie w Jira"| jira
        pr -.-> jira
    end
    subgraph r2[" "]
        direction RL
        merge["Scalenie do main"]
        art["Artefakty:<br/>obraz — tag = SHA commitu,<br/>chart — wersja z Chart.yaml"]
        dep["Wdrożenie<br/>ArgoCD targetRevision"]
        merge --> art --> dep
    end
    pr --> merge

    classDef plan fill:#ede7f6,stroke:#4527a0,color:#311b92;
    classDef git fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef artc fill:#fff3e0,stroke:#e65100,color:#e65100;
    classDef dpl fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef row fill:none,stroke:none;

    class jira plan;
    class br,com,pr,merge git;
    class art artc;
    class dep dpl;
    class r1,r2 row;
