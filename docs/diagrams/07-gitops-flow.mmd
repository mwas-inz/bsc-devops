---
title: Dostarczanie GitOps — uzgadnianie w modelu pull (ArgoCD, dwie równorzędne aplikacje)
config:
  theme: neo
---
flowchart LR
    subgraph git["Repozytorium Git"]
        appman["gitops/application.yaml<br/>gitops/observability.yaml"]
        sealed["gitops/secrets/*.sealed.yaml"]
    end

    ci["CI/CD<br/>publikuje charty Helm jako OCI"]
    ghcr["Rejestr OCI GHCR<br/>bsc-devops-apps, observability"]

    subgraph cluster["Klaster k3d"]
        argocd["Kontroler ArgoCD<br/>model pull"]
        appA["Application: bsc-devops<br/>chart bsc-devops-apps"]
        appB["Application: observability<br/>chart observability"]
        state["Bieżący stan klastra"]
    end

    ci --> ghcr
    appman -->|kubectl apply| argocd
    sealed -.->|bootstrap przed ArgoCD| cluster
    argocd --> appA
    argocd --> appB
    appA -->|pobiera przypięty chart| ghcr
    appB -->|pobiera przypięty chart| ghcr
    appA -->|"synchronizacja: prune + selfHeal"| state
    appB -->|"synchronizacja: prune + selfHeal"| state
    state -.->|wykryto drift| argocd

    classDef gitops fill:#ede7f6,stroke:#4527a0,color:#311b92;
    classDef reg fill:#fff3e0,stroke:#e65100,color:#e65100;
    class argocd,appA,appB gitops;
    class ghcr reg;
