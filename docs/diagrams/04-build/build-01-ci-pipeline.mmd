---
title: Łańcuch CI z bezpieczeństwem Shift-Left (GitHub Actions)
config:
  theme: neo
---
flowchart LR
    trigger["push / PR<br/>filtrowane po ścieżce usługi"]
    checkout["Pobranie kodu"]
    compile["Kompilacja (Gradle)"]
    test["Testy JUnit"]
    image["Budowa natywnego obrazu kontenera"]
    scan{"Skanowanie Trivy<br/>HIGH lub CRITICAL?"}
    sign["Podpis Cosign (keyless)<br/>po digeście obrazu, token OIDC"]
    push["Wypchnięcie obrazu do rejestru"]
    fail["Przerwanie łańcucha"]

    trigger --> checkout --> compile --> test --> image --> scan
    scan -->|brak| push --> sign
    scan -->|wykryto| fail

    classDef step fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef gate fill:#fff3e0,stroke:#e65100,color:#e65100;
    classDef bad fill:#ffebee,stroke:#c62828,color:#b71c1c;
    class checkout,compile,test,image,sign,push step;
    class scan gate;
    class fail bad;
