---
config:
  theme: neo
  themeVariables:
    fontSize: 22px
  flowchart:
    nodeSpacing: 30
    rankSpacing: 40
    padding: 4
    subGraphTitleMargin:
      top: 6
      bottom: 14
    diagramPadding: 8
    wrappingWidth: 600
---
%% Anatomia budowania natywnego — JIT kontra AOT
flowchart TB
    src["Kod źródłowy (Java)"]

    subgraph jvm["Ścieżka klasyczna (JVM)"]
        direction TB
        javac["javac → bajtkod"]
        jre["obraz z JRE<br/>(Dockerfile.jvm)"]
        jit["uruchomienie: JVM + JIT<br/>optymalizacja w czasie działania"]
        jout(["start: sekundy<br/>pamięć i obraz: większe"])
        javac --> jre --> jit --> jout
    end

    subgraph nat["Ścieżka projektu (natywna, AOT)"]
        direction TB
        gradle["./gradlew imageBuild<br/>profil prod: quarkus.native.enabled=true"]
        aot["kompilacja AOT w kontenerze Mandrel<br/>analiza zamkniętego świata"]
        mand["containerBuild = true — bez lokalnego GraalVM<br/>koszt: kompilacja trwa kilkanaście minut"]
        bin["binarka natywna<br/>build/*-runner"]
        dbuild["docker build — Dockerfile.native<br/>baza: ubi-minimal, użytkownik nie-root"]
        nout(["start: milisekundy<br/>pamięć i obraz: minimalne"])
        gradle --> aot --> bin --> dbuild --> nout
        aot -.- mand
    end

    src --> jvm
    src --> nat

    classDef buildtime fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef runtime fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef ghost fill:#f5f5f5,stroke:#9e9e9e,color:#757575,stroke-dasharray: 4 3;
    classDef srcc fill:#ede7f6,stroke:#4527a0,color:#311b92;

    class src srcc;
    class javac,jre,gradle,aot,bin,dbuild buildtime;
    class jit,jout,nout runtime;
    class mand ghost;
