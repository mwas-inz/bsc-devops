---
config:
  theme: neo
  themeVariables:
    fontSize: 22px
  flowchart:
    nodeSpacing: 30
    rankSpacing: 40
    padding: 4
    diagramPadding: 8
    wrappingWidth: 600
---
%% Zdarzenia i bramki CI — ten sam proces dla PR i dla main
flowchart TB
    ev(["zdarzenie GitHub"])
    prE["pull_request"]
    mainE["push na main"]
    filt["filtr ścieżek:<br/>tylko zmieniona usługa<br/>(apps/users/**)"]
    conc["concurrency:<br/>nowy bieg anuluje poprzedni<br/>(cancel-in-progress)"]
    pipe["proces: testy → obraz<br/>natywny → skanowanie Trivy"]
    check["status check per usługa<br/>„Build, Test, Scan<br/>&amp; Push — users”"]
    gate{{"ochrona gałęzi:<br/>scalenie zablokowane<br/>do zielonego buildu"}}
    pushi["push obrazu do Docker Hub<br/>tagi: SHA commitu + latest"]
    sign["podpis Cosign (keyless)<br/>po digeście obrazu"]

    ev --> prE
    ev --> mainE
    prE --> filt
    mainE --> filt
    filt --> conc --> pipe
    pipe -->|pull_request| check --> gate
    pipe -->|"push (main)"| pushi --> sign

    classDef evc fill:#ede7f6,stroke:#4527a0,color:#311b92;
    classDef shared fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef prc fill:#fff3e0,stroke:#e65100,color:#e65100;
    classDef mainc fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef sec fill:#fce4ec,stroke:#ad1457,color:#880e4f;

    class ev,prE,mainE evc;
    class filt,conc,pipe shared;
    class check,gate prc;
    class pushi mainc;
    class sign sec;
