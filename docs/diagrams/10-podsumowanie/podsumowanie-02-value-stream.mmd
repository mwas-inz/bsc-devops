---
config:
  theme: neo
  themeVariables:
    fontSize: 22px
  flowchart:
    nodeSpacing: 30
    rankSpacing: 40
    padding: 4
    diagramPadding: 8
    wrappingWidth: 600
---
%% Podróż jednej zmiany — dwa kroki ręczne, reszta automatyczna
flowchart TB
    subgraph r1[" "]
        direction LR
        commit("commit (push)<br/>KROK RĘCZNY")
        ci["CI: testy,<br/>budowanie natywne,<br/>skanowanie, podpis"]
        art["artefakty:<br/>obraz (Docker Hub)<br/>+ chart (GHCR)"]
        bump("decyzja o wydaniu:<br/>aktualizacja<br/>targetRevision<br/>KROK RĘCZNY")
        commit --> ci --> art --> bump
    end
    subgraph r2[" "]
        direction RL
        rec["ArgoCD: uzgodnienie"]
        roll["wdrożenie kroczące"]
        tele["obserwacja w Grafanie<br/>(logi, ślady, metryki)"]
        rec --> roll --> tele
    end
    bump --> rec

    classDef auto fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef manual fill:#ede7f6,stroke:#4527a0,color:#311b92;
    classDef row fill:none,stroke:none;
    class ci,art,rec,roll,tele auto;
    class commit,bump manual;
    class r1,r2 row;
