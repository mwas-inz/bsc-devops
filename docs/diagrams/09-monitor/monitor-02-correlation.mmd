flowchart TB
    subgraph write["Zapis — jedno żądanie, jeden identyfikator"]
        direction LR
        req["żądanie HTTP<br/>traceId: 4bf92f…"]
        svc["usługa Quarkus<br/>quarkus-opentelemetry"]
        loki[("Loki — wpis logu<br/>mdc.traceId = 4bf92f…")]
        tempo[("Tempo — spany śladu<br/>traceId = 4bf92f…")]
        prom[("Prometheus — metryki RED<br/>etykiety: usługa, endpoint")]
        req --> svc
        svc -->|log JSON| loki
        svc -->|spany| tempo
        svc -->|scrape /q/metrics| prom
    end

    subgraph read["Odczyt w Grafanie — nawigacja po identyfikatorze"]
        direction LR
        s1["1. Explore / Loki:<br/>znaleziony błąd w logu"]
        s2["2. Tempo: pełny ślad żądania<br/>span po spanie"]
        s3["3a. powrót do Loki:<br/>wszystkie logi tego żądania"]
        s4["3b. Prometheus:<br/>metryki usługi z mapy usług"]
        s1 -->|"klik: trace_id (derivedFields)"| s2
        s2 -->|tracesToLogsV2| s3
        s2 -->|serviceMap| s4
    end

