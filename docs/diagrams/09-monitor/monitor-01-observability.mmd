---
config:
  theme: neo
  themeVariables:
    fontSize: 22px
  flowchart:
    nodeSpacing: 30
    rankSpacing: 40
    padding: 4
    subGraphTitleMargin:
      top: 6
      bottom: 14
    diagramPadding: 8
    wrappingWidth: 600
---
%% Trzy sygnały, dwa wzorce transportu — OpenTelemetry i stos LGTM
flowchart LR
    subgraph app["Każda usługa Quarkus"]
        direction TB
        logs["logi: JSON na stdout<br/>quarkus-logging-json,<br/>MDC: traceId"]
        traces["ślady:<br/>quarkus-opentelemetry<br/>traceId / spanId"]
        metrics["metryki: Micrometer<br/>punkt /q/metrics"]
    end

    subgraph obs["Przestrzeń nazw: observability"]
        collector["OTel Collector<br/>wspólny punkt<br/>wejścia OTLP"]
        loki[("Loki<br/>logi")]
        tempo[("Tempo<br/>ślady")]
        prom[("Prometheus<br/>metryki")]
        grafana["Grafana<br/>wspólny interfejs,<br/>trzy źródła danych"]
    end

    logs ~~~ traces ~~~ metrics

    app -->|"push: OTLP<br/>(logi, ślady)"| collector
    collector -->|"potok<br/>logów"| loki
    collector -->|"potok<br/>śladów"| tempo
    app -.->|"pull: scrape<br/>/q/metrics"| prom

    loki --> grafana
    tempo --> grafana
    prom --> grafana

    classDef svc fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef store fill:#fff3e0,stroke:#e65100,color:#e65100;
    classDef viz fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    class logs,traces,metrics svc;
    class loki,tempo,prom store;
    class grafana,collector viz;
