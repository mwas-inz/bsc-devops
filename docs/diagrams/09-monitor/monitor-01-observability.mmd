    logs -->|"push: OTLP"| collector
    traces -->|"push: OTLP"| collector
    collector -->|potok logów| loki
    collector -->|potok śladów| tempo
    metrics -.->|"pull: inicjowane przez Prometheus (scrape /q/metrics)"| prom

    loki --> grafana
    tempo --> grafana
    prom --> grafana

