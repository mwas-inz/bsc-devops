      top: 6
      bottom: 14
    diagramPadding: 8
    wrappingWidth: 600
---
%% Dostarczanie GitOps — pętla uzgadniania w modelu pull (ArgoCD)
flowchart TB
    git["Repozytorium Git<br/>gitops/ — definicje Application"]
    ci["cd-helm publikuje charty<br/>(zob. etap Release)"]
    ghcr[("GHCR — rejestr OCI<br/>charty: bsc-devops-apps,<br/>observability")]

    subgraph cluster["Klaster k3d&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        apps["2 × Application<br/>chart + przypięty targetRevision"]
        argocd["Kontroler ArgoCD"]
        state["Bieżący stan klastra<br/>Deployment, Service, ..."]
    end

    ci -.-> ghcr
    git -.->|"jednorazowy bootstrap:<br/>kubectl apply<br/>definicji Application"| apps

    apps -->|"1. stan pożądany:<br/>chart + wersja"| argocd
    argocd -->|"2. pull chartu<br/>— połączenie<br/>inicjowane z klastra"| ghcr
    state -->|"3. obserwacja<br/>stanu bieżącego"| argocd
    argocd -->|"4. synchronizacja:<br/>prune + selfHeal"| state

    note["pętla powtarzana cyklicznie — poza jednorazowym<br/>bootstrapem żadna strzałka nie prowadzi do wnętrza<br/>klastra: CI nie ma poświadczeń klastra"]
    state ~~~ note

    classDef hub fill:#ede7f6,stroke:#4527a0,color:#311b92;
    classDef gitops fill:#ede7f6,stroke:#4527a0,color:#311b92;
    classDef reg fill:#fff3e0,stroke:#e65100,color:#e65100;
    classDef live fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef ghost fill:#f5f5f5,stroke:#9e9e9e,color:#757575,stroke-dasharray: 4 3;
    classDef notec fill:#fffde7,stroke:#f9a825,color:#795548;
    class git hub;
    class argocd,apps gitops;
    class ghcr reg;
    class state live;
    class ci ghost;
    class note notec;
