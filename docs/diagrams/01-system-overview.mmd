flowchart TB
    user["Użytkownik (przeglądarka)"]

    subgraph cluster["Klaster Kubernetes (k3d)"]
        traefik["Traefik Ingress"]

        subgraph ns["Przestrzeń nazw: bsc-devops"]
            fe["frontend<br/>Vue 3 (nginx)"]
            users["users<br/>usługa Quarkus"]
            tasks["tasks<br/>usługa Quarkus"]
            archiver["task-archiver<br/>konsument Quarkus"]
            pulsar{{"Apache Pulsar<br/>broker komunikatów"}}
            db[("PostgreSQL")]
        end
    end

    user -->|ładuje stronę| traefik
    user -->|REST /api| traefik
    traefik -->|/| fe
    traefik -->|/api/users| users
    traefik -->|/api/tasks| tasks

    users --> db
    tasks --> db
    archiver --> db

    users -.->|user-events| pulsar
    pulsar -.->|user-events| tasks
    tasks -.->|delete-tasks| pulsar
    pulsar -.->|delete-tasks| archiver

    classDef svc fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef data fill:#fff3e0,stroke:#e65100,color:#e65100;
    classDef infra fill:#ede7f6,stroke:#4527a0,color:#311b92;
    class fe,users,tasks,archiver svc;
    class db,pulsar data;
    class traefik infra;
