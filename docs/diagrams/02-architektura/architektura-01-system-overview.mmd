---
config:
  theme: neo
  themeVariables:
    fontSize: 22px
  flowchart:
    nodeSpacing: 30
    rankSpacing: 40
    padding: 12
    subGraphTitleMargin:
      top: 6
      bottom: 14
    diagramPadding: 8
    wrappingWidth: 600
---
%% Architektura systemu — ścieżka synchroniczna i zdarzeniowa w jednym przeglądzie
flowchart TB
    user["Użytkownik<br/>(przeglądarka)"]

    subgraph cluster["Klaster k3d — przestrzeń nazw bsc-devops"]
        traefik["Traefik Ingress"]
        fe["frontend<br/>Vue 3 + nginx"]
        users["users<br/>Quarkus (natywny)"]
        tasks["tasks<br/>Quarkus (natywny)"]
        arch["task-archiver<br/>Quarkus (natywny)"]
        db[("PostgreSQL")]

        subgraph pulsar["Apache Pulsar&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
            t1[/"temat: user-events"/]
            t2[/"temat: delete-tasks"/]
        end
    end

    user -->|HTTP| traefik
    traefik -->|"/"| fe
    traefik -->|"/api/users"| users
    traefik -->|"/api/tasks"| tasks

    users -->|JDBC| db
    tasks -->|JDBC| db
    arch -->|JDBC| db

    users -.->|"CREATED /<br/>DELETED"| t1
    t1 -.-> tasks
    tasks -.->|"usunięcie<br/>użytkownika"| t2
    t2 -.-> arch

    rm["tasks utrzymuje lokalny model odczytu<br/>użytkowników (KnownUser) zasilany<br/>zdarzeniami — walidacja bez<br/>synchronicznego wywołania users"]
    leg["linie ciągłe: komunikacja<br/>synchroniczna (HTTP, JDBC)<br/>linie przerywane: zdarzenia<br/>asynchroniczne (Pulsar)"]
    tasks -.- rm
    db ~~~ rm
    db ~~~ leg

    classDef svc fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef data fill:#fff3e0,stroke:#e65100,color:#e65100;
    classDef infra fill:#ede7f6,stroke:#4527a0,color:#311b92;
    classDef person fill:#ede7f6,stroke:#4527a0,color:#311b92;
    classDef note fill:#fffde7,stroke:#f9a825,color:#795548;
    classDef ghost fill:#f5f5f5,stroke:#9e9e9e,color:#757575,stroke-dasharray: 4 3;

    class fe,users,tasks,arch svc;
    class db,t1,t2 data;
    class traefik infra;
    class user person;
    class rm note;
    class leg ghost;
