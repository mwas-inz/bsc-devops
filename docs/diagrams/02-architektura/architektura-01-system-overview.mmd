---
title: Architektura systemu — ścieżka synchroniczna i zdarzeniowa w jednym przeglądzie
config:
  theme: neo
---
flowchart LR
    user["Użytkownik<br/>(przeglądarka)"]

    subgraph cluster["Klaster k3d — przestrzeń nazw bsc-devops"]
        traefik["Traefik Ingress"]
        fe["frontend<br/>Vue 3 + nginx"]
        users["users<br/>Quarkus (natywny)"]
        tasks["tasks<br/>Quarkus (natywny)"]
        arch["task-archiver<br/>Quarkus (natywny)"]
        db[("PostgreSQL")]

        subgraph pulsar["Apache Pulsar — broker komunikatów"]
            t1[/"temat: user-events"/]
            t2[/"temat: delete-tasks"/]
        end
    end

    user -->|HTTP| traefik
    traefik -->|"/"| fe
    traefik -->|"/api/users"| users
    traefik -->|"/api/tasks"| tasks

    users -->|JDBC| db
    tasks -->|JDBC| db
    arch -->|JDBC| db

    users -.->|"CREATED / DELETED"| t1
    t1 -.-> tasks
    tasks -.->|"usunięcie użytkownika"| t2
    t2 -.-> arch

    rm["tasks utrzymuje lokalny model odczytu użytkowników (KnownUser)<br/>zasilany zdarzeniami — walidacja bez synchronicznego wywołania users"]
    leg["linie ciągłe: komunikacja synchroniczna (HTTP, JDBC)<br/>linie przerywane: zdarzenia asynchroniczne (Pulsar)"]
    tasks -.- rm
    cluster ~~~ leg

    classDef svc fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
