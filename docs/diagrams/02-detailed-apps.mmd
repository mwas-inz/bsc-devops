---
title: Architektura aplikacji — synchroniczny REST i asynchroniczna komunikacja
config:
  theme: neo
---
flowchart LR
    browser["Przeglądarka (SPA)"]
    traefik["Traefik Ingress"]

    subgraph sync["Synchronicznie — REST po HTTP"]
        users["usługa users"]
        tasks["usługa tasks"]
    end

    subgraph async["Asynchronicznie — tematy Pulsar"]
        pulsar{{"Apache Pulsar"}}
        archiver["task-archiver"]
    end

    %% invisible link: gives `sync` the same two-rank structure as `async`
    %% so dagre sizes the two subgraph boxes congruently (no visible edge)
    users ~~~ tasks

    db[("PostgreSQL")]

    browser --> traefik
    traefik -->|/api/users| users
    traefik -->|/api/tasks| tasks

    users -->|JDBC| db
    tasks -->|JDBC| db
    archiver -->|JDBC| db

    users -->|"wychodzący: user-events"| pulsar
    pulsar -->|"przychodzący: user-events"| tasks
    tasks -->|"wychodzący: delete-tasks"| pulsar
    pulsar -->|"przychodzący: delete-tasks"| archiver

    classDef svc fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
    classDef data fill:#fff3e0,stroke:#e65100,color:#e65100;
    class users,tasks,archiver svc;
    class db,pulsar data;
