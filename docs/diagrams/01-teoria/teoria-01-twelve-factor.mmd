        f3["III. Konfiguracja"] --> i3["zmienne środowiskowe: ConfigMap app-config<br/>+ Secret db-secret (SealedSecret)"]
        f4["IV. Usługi wspierające"] --> i4["PostgreSQL i Pulsar dołączane<br/>przez konfigurację, nie przez kod"]
    end

    subgraph g3["Cykl życia"]
        direction LR
        f5["V. Buduj, publikuj, uruchamiaj"] --> i5["CI: obraz (tag = SHA) → chart wiąże<br/>konfigurację → ArgoCD uruchamia"]
        f6["VI. Procesy"] --> i6["bezstanowe usługi Quarkus<br/>stan wyłącznie w PostgreSQL"]
        f7["VII. Przydzielanie portów"] --> i7["quarkus.http.port=8080<br/>Service + Traefik kierują ruch"]
        f8["VIII. Współbieżność"] --> i8["skalowanie liczbą replik<br/>(values.yaml: replicas)"]
        f9["IX. Jednorazowość"] --> i9["start natywny w milisekundach, sondy<br/>wdrożenie kroczące"]
    end

    subgraph g4["Środowiska i eksploatacja"]
        direction LR
        f10["X. Jednolitość środowisk"] --> i10["k3d = to samo API Kubernetes<br/>Dev Services = ten sam PostgreSQL w testach"]
        f11["XI. Logi"] --> i11["JSON na stdout (profil prod) → OTLP → Loki<br/>MDC: traceId"]
        f12["XII. Zarządzanie aplikacją"] --> i12["realizowane odmiennie: schemat DB aktualizowany przy starcie<br/>(schema-management: update) — świadome uproszczenie"]
    end

